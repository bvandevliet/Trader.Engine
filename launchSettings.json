{
  "profiles": {
    "Docker Compose": {
      "commandName": "DockerCompose",
      "commandVersion": "1.0",
      "composeProfile": {
        "includes": [
          "docker"
        ],
        "serviceActions": {
          "traderengine.api": "StartDebugging",
          "traderengine.web": "StartDebugging"
        }
      },
      "composeLaunchAction": "LaunchBrowser",
      "composeLaunchServiceName": "traderengine.web",
      "composeLaunchUrl": "{Scheme}://{ServiceIPAddress}:{ServicePort}"
    }
  }
}