{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System.Net.Http.HttpClient": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Extensions.Http": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Rebalancing": {
    "FillWaitTimeoutSeconds": 60
  },
  "Automation": {
    "MaxConcurrentRuns": 5
  },
  "AllowedHosts": "*"
}
