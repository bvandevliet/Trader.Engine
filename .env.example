# Development relaxes the auth cookie to work over plain HTTP (no Secure flag enforced) and
# exposes dev-only diagnostics (EF migrations endpoint, wider dev CSP). Remove this line (or set
# to Production) before any real deployment — Production is the default when unset.
ASPNETCORE_ENVIRONMENT=Development

POSTGRES_DATABASE=Trader.Engine
POSTGRES_USERNAME=dev
POSTGRES_PASSWORD=dev

CMC_API_KEY=secret-api-key

JWT_SIGNING_KEY=dev-signing-key-change-me-in-production-at-least-32-bytes

ADMIN_USERNAME=dev
ADMIN_EMAIL=dev@example.com
ADMIN_PASSWORD=Dev123!Password

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=dev
SMTP_PASSWORD=dev
FROM_EMAIL_ADDRESS=your-from-address@gmail.com
WEBSITE_URL=http://localhost:8081

# One-shot WordPress -> Postgres migration (see docker-compose.yml's `migrate` profile). Only
# needed when actually running `docker compose --profile migrate run --rm traderengine.migration`;
# points at the legacy homelab WordPress/MariaDB instance and its cryptography sidecar, not
# anything started by this compose file.
WORDPRESS_DB_HOST=wordpress-host.local
WORDPRESS_DB_PORT=3306
WORDPRESS_DB_DATABASE=wordpress
WORDPRESS_DB_USERNAME=wordpress
WORDPRESS_DB_PASSWORD=wordpress
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_CRYPTO_URL=http://traderengine-cryptography.local/