@page
@model EmailModel
@{
    ViewData["Title"] = "Email";
}

<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="row">
    <div class="col-md-6">
        <form id="email-form" method="post">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            @if (Model.IsEmailConfirmed)
            {
                <div class="input-group mb-3">
                    <div class="form-floating">
                        <input asp-for="Email" class="form-control" placeholder="" disabled />
                        <label asp-for="Email" class="form-label"></label>
                    </div>
                    <span class="input-group-text text-success fw-bold">✓</span>
                </div>
            }
            else
            {
                <div class="input-group mb-3">
                    <div class="form-floating">
                        <input asp-for="Email" class="form-control" placeholder="" disabled />
                        <label asp-for="Email" class="form-label"></label>
                    </div>
                    <button id="email-verification-button" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-outline-secondary">Send verification email</button>
                </div>
            }
            <div class="form-floating mb-3">
                <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="" />
                <label asp-for="Input.NewEmail" class="form-label"></label>
                <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
            </div>
            <button id="update-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn btn-primary">Change email</button>
        </form>
    </div>
</div>
