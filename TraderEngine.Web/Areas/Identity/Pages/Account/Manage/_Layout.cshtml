@{
    Layout = ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout is string parentLayoutPath
        ? parentLayoutPath
        : "/Pages/Shared/_Layout.cshtml";
}

<h1>Manage your account</h1>
<hr />
<div class="row">
    <div class="col-md-3">
        <partial name="_ManageNav" />
    </div>
    <div class="col-md-9">
        @RenderBody()
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
